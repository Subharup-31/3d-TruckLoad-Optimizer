# Free routing & geocoding — no paid API keys required

# Road routing: OSRM (https://router.project-osrm.org)
# Sea routing: searoute-ts (Eurostat maritime network, bundled offline)
# Air routing: Great-circle geodesic + Open-Meteo jet-stream data
# Location search: Photon (Komoot) + Nominatim (OpenStreetMap)

# Optional: OpenRouter for AI chatbot + stability reports
# Chat: nvidia/nemotron-3.5-lightning:free | Analysis: nvidia/nemotron-3-super-120b-a12b:free
# VITE_OPENROUTER_API_KEY=your_key_here

VITE_USE_MOCK_DATA=false
